# Copy to .env and adjust. Every setting can also be set as an environment variable.
# With nothing changed, everything runs locally in demo mode with no accounts needed.

HVAC_ENVIRONMENT=dev                       # dev | prod
HVAC_DATABASE_URL=sqlite+aiosqlite:///./var/hvac.db
# Production: HVAC_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/hvac

# --- Secrets (MUST be changed for production) -------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# HVAC_JWT_SECRET=
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HVAC_ENCRYPTION_KEY=

# --- AI photo analysis --------------------------------------------------------------
# fake = rule-based demo analysis; anthropic = Claude reads the photo for real.
HVAC_AI_PROVIDER=fake
# HVAC_AI_PROVIDER=anthropic
# HVAC_ANTHROPIC_API_KEY=sk-ant-...
# HVAC_ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Payments ------------------------------------------------------------------------
# fake = demo card form, nothing charged; stripe = real Stripe (use test keys first).
HVAC_PAYMENTS_PROVIDER=fake
# HVAC_PAYMENTS_PROVIDER=stripe
# HVAC_STRIPE_SECRET_KEY=sk_test_...
# HVAC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# HVAC_STRIPE_WEBHOOK_SECRET=whsec_...
HVAC_PLATFORM_FEE_BPS=1500                 # 15.00%

# --- Text messages -----------------------------------------------------------------------
# console = codes are printed in the API window and shown on screen (demo).
HVAC_SMS_PROVIDER=console
# HVAC_SMS_PROVIDER=twilio
# HVAC_TWILIO_ACCOUNT_SID=AC...
# HVAC_TWILIO_AUTH_TOKEN=...
# HVAC_TWILIO_FROM_NUMBER=+1...

# --- Address lookup -----------------------------------------------------------------------
# fake = places any address near Atlanta (demo); mapbox = real geocoding.
HVAC_GEOCODING_PROVIDER=fake
# HVAC_GEOCODING_PROVIDER=mapbox
# HVAC_MAPBOX_TOKEN=pk...

# --- URLs ----------------------------------------------------------------------------------
HVAC_PUBLIC_API_URL=http://localhost:8000
HVAC_PUBLIC_WEB_URL=http://localhost:5173
